#usda 1.0
(
    doc = "Synthetic fastener library for BeamCraft tests. Contributor-original, MPL-2.0. Every value is invented; none follows or reproduces any national standard, manufacturer catalogue or commercial table. Not for design use."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "beamcraft-synthetic-fasteners"
        string "bim:library:title" = "BeamCraft synthetic test fasteners"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Contributor-original synthetic values for tests; no standard, catalogue or vendor data"
        string "bim:library:licence" = "MPL-2.0"
    }
)

def Scope "Library"
{
    def Scope "Fasteners"
    {
        def Scope "SYN_BOLT_12x50"
        {
            string steel:fastener:designation = "SYN-BOLT-12x50"
            string steel:fastener:standard = "Synthetic"
            string steel:fastener:grade = "SYN-8"
            token steel:fastener:kind = "bolt"
            token steel:fastener:headKind = "hex"
            double steel:fastener:nominalDiameterMm = 12
            double steel:fastener:headAcrossFlatsMm = 17
            double steel:fastener:headHeightMm = 6.5
            double steel:fastener:nutAcrossFlatsMm = 17
            double steel:fastener:nutHeightMm = 9
            double steel:fastener:washerOuterDiameterMm = 22
            double steel:fastener:washerInnerDiameterMm = 13
            double steel:fastener:washerThicknessMm = 2
            double steel:fastener:holeClearanceMm = 1.5
            double[] steel:fastener:lengthsMm = [30, 40, 50, 60, 80]
            double steel:fastener:threadProtrusionMm = 3
            bool steel:fastener:washerUnderHead = true
            bool steel:fastener:washerUnderNut = true
            token steel:fastener:holeMode = "generate"
        }

        def Scope "SYN_BOLT_16x70_BARE"
        {
            string steel:fastener:designation = "SYN-BOLT-16x70-BARE"
            string steel:fastener:standard = "Synthetic"
            string steel:fastener:grade = "SYN-8"
            token steel:fastener:kind = "bolt"
            token steel:fastener:headKind = "hex"
            double steel:fastener:nominalDiameterMm = 16
            double steel:fastener:headAcrossFlatsMm = 23
            double steel:fastener:headHeightMm = 9
            double steel:fastener:nutAcrossFlatsMm = 23
            double steel:fastener:nutHeightMm = 12
            double steel:fastener:holeClearanceMm = 0
            double[] steel:fastener:lengthsMm = [40, 50, 70, 90]
            double steel:fastener:threadProtrusionMm = 4
            bool steel:fastener:washerUnderHead = false
            bool steel:fastener:washerUnderNut = false
            token steel:fastener:holeMode = "generate"
        }

        def Scope "SYN_SCREW_10x30"
        {
            string steel:fastener:designation = "SYN-SCREW-10x30"
            string steel:fastener:standard = "Synthetic"
            token steel:fastener:kind = "screw"
            token steel:fastener:headKind = "hex"
            double steel:fastener:nominalDiameterMm = 10
            double steel:fastener:headAcrossFlatsMm = 15
            double steel:fastener:headHeightMm = 6
            double steel:fastener:washerOuterDiameterMm = 19
            double steel:fastener:washerInnerDiameterMm = 10.5
            double steel:fastener:washerThicknessMm = 1.6
            double steel:fastener:holeClearanceMm = 0
            double[] steel:fastener:lengthsMm = [20, 30, 40]
            double steel:fastener:threadProtrusionMm = 2
            bool steel:fastener:washerUnderHead = true
            bool steel:fastener:washerUnderNut = false
            token steel:fastener:holeMode = "none"
        }
    }
}

#usda 1.0
(
    doc = "BeamCraft Canada structural steel grades: the complete weldable (W) category of CSA G40.20-13/G40.21-13 — the combined General requirements for rolled or welded structural quality steel / Structural quality steel — in the metric designations the Canadian practice uses: 260W, 300W, 350W, 380W, 400W, 480W and 550W, where the number is the minimum yield strength in MPa and W is the weldable category. 380W is available only as hollow structural sections, angles and bars, the scope note the standard's grade table carries. The impact-tested (WT), atmospheric-corrosion-resistant (R, A, AT) and quenched-and-tempered (Q, QT) categories are not in the pack. Re-entered by hand as our own data; no text or table is copied from the standard. The density is the 7850 kg/m3 every shipped profile pack computes its masses with (EN 1991-1-1). Not for design use."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "canada-csa-g4021-materials"
        string "bim:library:title" = "CSA G40.21 structural steel grades (weldable category)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Public standard CSA G40.20-13/G40.21-13 weldable-category grade designations, the complete metric W series, re-entered as our own data; density is the 7850 kg/m3 of EN 1991-1-1 and of the shipped profile packs"
        string "bim:library:licence" = "MPL-2.0"
    }
)

def Scope "Library"
{
    def Scope "Materials"
    {
        def Scope "W_260W"
        {
            string steel:material:grade = "260W"
            string steel:material:standard = "CSA G40.20-13/G40.21-13"
            double steel:material:densityKgM3 = 7850
        }
        def Scope "W_300W"
        {
            string steel:material:grade = "300W"
            string steel:material:standard = "CSA G40.20-13/G40.21-13"
            double steel:material:densityKgM3 = 7850
        }
        def Scope "W_350W"
        {
            string steel:material:grade = "350W"
            string steel:material:standard = "CSA G40.20-13/G40.21-13"
            double steel:material:densityKgM3 = 7850
        }
        def Scope "W_380W"
        {
            string steel:material:grade = "380W"
            string steel:material:standard = "CSA G40.20-13/G40.21-13"
            double steel:material:densityKgM3 = 7850
        }
        def Scope "W_400W"
        {
            string steel:material:grade = "400W"
            string steel:material:standard = "CSA G40.20-13/G40.21-13"
            double steel:material:densityKgM3 = 7850
        }
        def Scope "W_480W"
        {
            string steel:material:grade = "480W"
            string steel:material:standard = "CSA G40.20-13/G40.21-13"
            double steel:material:densityKgM3 = 7850
        }
        def Scope "W_550W"
        {
            string steel:material:grade = "550W"
            string steel:material:standard = "CSA G40.20-13/G40.21-13"
            double steel:material:densityKgM3 = 7850
        }
    }
}

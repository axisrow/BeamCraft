#usda 1.0
(
    doc = "BeamCraft USA structural bolt set: heavy hex structural bolts of ASTM F3125 Grades A325 (Group 120) and A490 (Group 150) with their heavy hex nuts (ASTM A563, the A194 Grade 2H substitution of RCSC 2025 2.3.2), re-entered by hand as our own data. The nominal, head and nut dimensions per RCSC 2025 Commentary Table C-2.1; every row declares the standard hole of RCSC 2025 Table 3.1, the only hole type the model carries: oversize and slotted holes have no representation yet. Inch values are converted exactly (x 25.4). Offered lengths and thread protrusion are contributor defaults; washers (ASTM F436) are not in the pack. No text or table is copied. BeamCraft contributors, MPL-2.0. Not for design use."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "beamcraft-rcsc-fasteners"
        string "bim:library:title" = "BeamCraft USA structural bolt set (ASTM F3125 A325 and A490, RCSC 2025)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Public specification RCSC 2025 (June 5, 2025, boltcouncil.org): Table 3.1 hole dimensions, Commentary C-2.1 bolt and nut dimensions; bolt grades per ASTM F3125; re-entered as our own data; lengths and protrusion are contributor defaults"
        string "bim:library:licence" = "MPL-2.0"
    }
)


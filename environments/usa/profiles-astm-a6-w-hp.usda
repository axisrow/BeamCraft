#usda 1.0
(
    doc = "BeamCraft USA environment: hot-rolled wide-flange W shapes and bearing-pile HP shapes of ASTM A6/A6M-05a. The nominal dimensions, areas and masses are the standard's own SI values (Annex A2), re-entered by hand as our own data; no text or table is copied and nothing is converted. Designations are in the EDI inch form (W44X335, HP14X117); the mass per metre is the nominal SI mass of the standard's metric designation. The root radius, which the standard does not print, is the fillet radius of the Nucor-Yamato Steel Structural Shapes catalog for the shapes it rolls and zero (a sharp corner) for the others. Reference data for modelling; it is not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "usa-astm-a6-w-hp-profiles"
        string "bim:library:title" = "USA hot-rolled sections (ASTM A6/A6M: W, HP)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "ASTM A6/A6M-05a Annex A2 W and HP facts (SI column), re-entered by hand as our own data from two public copies (holapl.com, womicsteel.com); root radius from the Nucor-Yamato catalog (nucoryamato.com), which cross-checks the rows; no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


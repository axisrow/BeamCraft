#usda 1.0
(
    doc = "BeamCraft USA environment: the American Standard beams (S) and channels (C) of ASTM A6/A6M-05a. The nominal dimensions, areas and masses are the standard's own SI values (Annex A2), re-entered by hand as our own data; no text or table is copied and nothing is converted. Designations are the EDI inch form (S24X121, C15X50); the mass per metre is the nominal SI mass of the standard's metric designation. The inner flange faces rise at the approximately 16 2/3 percent slope the standard's terminology prints for S and C shapes; the root radius, which the standard does not print, is the fillet radius of the Nucor-Yamato Steel Structural Shapes catalog for the shapes it rolls and zero for the others; no admitted source prints a toe radius, so every row keeps a sharp toe. Reference data for modelling; not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "usa-astm-a6-s-c-profiles"
        string "bim:library:title" = "USA hot-rolled sections (ASTM A6/A6M: S, C)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "ASTM A6/A6M-05a Annex A2 S and C facts (SI column), re-entered by hand as our own data from two public copies (holapl.com, womicsteel.com), agreeing value for value on all 59 rows; root radius from the Nucor-Yamato catalog; no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


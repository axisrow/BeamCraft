#usda 1.0
(
    doc = "BeamCraft Brazil environment: the hot-rolled wide-flange W shapes and bearing-pile HP shapes of the ASTM A6/A6M assortment, whose tables ABNT NBR 15980 carries as its own W and HP content. The nominal dimensions, areas and masses are the standard's own SI values, the rows of the shipped usa pack re-entered as our own data; no text or table is copied and nothing is converted. Designations are in the form the regional producers print (W 310 x 60,0), the mass the nominal SI mass of the designation. The root radius, which the standards do not print, is the fillet radius of the Nucor-Yamato catalog for the shapes it rolls and zero (a sharp corner) for the others. Reference data for modelling; it is not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "brazil-abnt-nbr-15980-profiles"
        string "bim:library:title" = "Brazil hot-rolled sections (ABNT NBR 15980: W, HP)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "ASTM A6/A6M-05a Annex A2 SI facts and SI designations, the rows of the shipped usa pack, under the producers' metric designations; cross-checked against the Gerdau and Nucor-Yamato catalogs; no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


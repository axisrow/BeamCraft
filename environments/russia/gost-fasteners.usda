#usda 1.0
(
    doc = "BeamCraft Russian hex-bolt set: the dimensions of GOST 7798-70 (hex head bolt, product grade B, edition 2010 with amendments 2-6, corresponding to ST SEV 4728-84), GOST 5915-70 (hex nut, edition 2010 with amendments 2-7) and GOST 11371-78 (plain washer, class A), re-entered by hand as our own data; standard holes follow the preferred (first) row of GOST 11284-75. Designations are Latinized (the standard prints the Cyrillic M). No text or table is copied from a standard document. BeamCraft contributors, MPL-2.0. Not for design use."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "beamcraft-gost-fasteners"
        string "bim:library:title" = "BeamCraft Russian hex bolt set (GOST 7798-70, GOST 5915-70, GOST 11371-78)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Public standards GOST 7798-70 (ed. 2010, am. 2-6, ST SEV 4728-84), GOST 5915-70 (ed. 2010, am. 2-7, ST SEV 3683-82), GOST 11371-78 (class A) and GOST 11284-75 (first row), re-entered as our own data; thread protrusion is a contributor default"
        string "bim:library:licence" = "MPL-2.0"
    }
)


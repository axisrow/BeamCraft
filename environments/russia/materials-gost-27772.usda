#usda 1.0
(
    doc = "BeamCraft Russia structural steel grades: the complete grade set of GOST 27772-2015 (rolled products for construction steel structures), clause 4.1: С235, С245, С255, С345, С345К, С355, С355-1, С355К, С355П, С390, С390-1, С440, С550, С590. The designations are the standard's own Cyrillic forms — the leading letter is the Cyrillic С (U+0421), not the Latin C or the transliteration S — where С means structural construction steel, the number is the conventional yield strength in N/mm2, 1 a chemistry variant, К an increased corrosion resistance, П an increased fire resistance. Re-entered by hand as our own data; no text or table is copied from the standard. The density is the 7850 kg/m3 every shipped profile pack computes its masses with (EN 1991-1-1; СП 16.13330). Not for design use."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "russia-gost-27772-materials"
        string "bim:library:title" = "GOST 27772-2015 structural steel grades"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Public standard GOST 27772-2015 clause 4.1 grade designations, the complete 2015 grade set, cross-checked against a second independent full text, re-entered as our own data; density is the 7850 kg/m3 of EN 1991-1-1 and of the shipped profile packs"
        string "bim:library:licence" = "MPL-2.0"
    }
)

def Scope "Library"
{
    def Scope "Materials"
    {
        def Scope "S235"
        {
            string steel:material:grade = "С235"
            string steel:material:standard = "GOST 27772-2015"
            double steel:material:densityKgM3 = 7850
        }

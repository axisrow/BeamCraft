#usda 1.0
(
    doc = "BeamCraft Russia environment: cold-bent closed welded square hollow sections of GOST 30245-2003, table 1. The nominal dimensions, areas and masses are the published values of the public standard, re-entered by hand as our own data; no text or table is copied. Every row follows the corner geometry the standard fixes in its notes to tables 1 and 2: the outer corner radius is 2t up to 6 mm wall, 2.5t from 6 to 10 mm and 3t above 10 mm, and the inner radius is the outer radius minus the wall. The designation is the Latinized profile size (the authentic form of clause 3.9, for example «Профиль 60х60х3 ГОСТ 30245-2003»). This library holds the complete square series the 2003 assortment publishes, sizes 40x40 to 300x300; the rectangular series of the same standard is a separate pack. Reference data for modelling; it is not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "russia-gost-30245-squares"
        string "bim:library:title" = "Russia cold-bent square hollow sections (GOST 30245-2003: the complete square series, 40x40 to 300x300)"
        string "bim:library:version" = "2"
        string "bim:library:source" = "Dimensional facts of GOST 30245-2003 table 1 (square series), re-entered by hand as our own data; cross-checked between three scans (meganorm.ru text, files.stroyinf.ru typeset, splav-kharkov.com raster); no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


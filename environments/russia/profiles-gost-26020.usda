#usda 1.0
(
    doc = "BeamCraft Russia environment: hot-rolled I beams with parallel flanges of the beam (Б), wide-flange (Ш) and column (К) series of GOST 26020-83. The nominal dimensions, areas and masses are the published values of the public standard, re-entered by hand as our own data; no text or table is copied. Designations are Latinized (Б to B, Ш to Sh, К to K). Reference data for modelling; it is not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "russia-gost-26020-profiles"
        string "bim:library:title" = "Russia hot-rolled sections (GOST 26020-83: beam, wide-flange and column I beams)"
        string "bim:library:version" = "2"
        string "bim:library:source" = "Dimensional facts of GOST 26020-83 (beam, wide-flange and column series), re-entered by hand as our own data; cross-checked against two scans (bulat-metal.com.ua, files.stroyinf.ru) and the metcalc.ru, saitinpro.ru tables; no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


#usda 1.0
(
    doc = "BeamCraft Russia environment: the hot-rolled inclined-flange I beams of GOST 8239-89 (10 to 60) and the slope-series channels of GOST 8240-89 table 1 (5 to 40), through the tapered_i and tapered_c families. The nominal dimensions, areas and masses are the published values of the public standards, re-entered by hand as our own data; no text or table is copied. t is the mean flange thickness at the middle of the leg; r and r1 are the root and toe radii, printed «не более» as roll-pass values not inspected on the finished product. Neither standard prints a per-row slope: the inner faces rise at 6-12 % (I) and 4-10 % (C) as a roll-pass range, so each row carries the range middle (0.09, 0.07) and the tests hold the declared areas warning-free at both range ends. Designations are Latin; the standards designate by number only («Двутавр 10», «Швеллер 5»). The parallel-flange П series (table 2) is a different family and is not here. Reference data; not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "russia-gost-8239-8240-profiles"
        string "bim:library:title" = "Russia hot-rolled sections (GOST 8239-89 inclined-flange I beams, GOST 8240-89 inclined-flange channels)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Dimensional facts of GOST 8239-89 and GOST 8240-89 table 1 (inclined-flange series), re-entered by hand as our own data; cross-checked between the files.stroyinf.ru official scans, pkd-steel.by and the metcalc.ru, ros-met.com tables; no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


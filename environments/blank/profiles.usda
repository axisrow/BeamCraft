#usda 1.0
(
    doc = "BeamCraft base profile library: generic sections so a new model can place beams and columns at once. Contributor-original, MPL-2.0. Every value is invented and rounded; none follows or reproduces any national standard, manufacturer catalogue or commercial table. Not for design use."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "blank-profiles"
        string "bim:library:title" = "Blank profiles (generic, not a standard)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Contributor-original generic values for first use and tests; no standard, catalogue or vendor data"
        string "bim:library:licence" = "MPL-2.0"
    }
)


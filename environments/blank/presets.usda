#usda 1.0
(
    doc = "BeamCraft base part presets: the defaults a new beam, column or plate starts from. Contributor-original, MPL-2.0. Every value is invented; none follows or reproduces any national standard, manufacturer catalogue or commercial table. The first preset of a kind in name order is its default."
    metersPerUnit = 0.001
    upAxis = "Z"
)

def Scope "Presets"
{
    def Scope "Beam"
    {
        token steel:preset:kind = "beam"
        string steel:preset:name = "Beam"
        int steel:preset:class = 2
        string steel:preset:material = "Steel"
        string steel:preset:profile = "I-300x150"
    }

    def Scope "Beam_Heavy"
    {
        token steel:preset:kind = "beam"
        string steel:preset:name = "Beam heavy"
        int steel:preset:class = 2
        string steel:preset:material = "Steel"
        string steel:preset:profile = "I-500x200"
    }

    def Scope "Beam_Light"
    {
        token steel:preset:kind = "beam"
        string steel:preset:name = "Beam light"
        int steel:preset:class = 2
        string steel:preset:material = "Steel"
        string steel:preset:profile = "I-200x100"
    }

    def Scope "Column"
    {
        token steel:preset:kind = "column"
        string steel:preset:name = "Column"
        int steel:preset:class = 1
        string steel:preset:material = "Steel"
        string steel:preset:profile = "H-200x200"
    }

    def Scope "Column_Heavy"
    {
        token steel:preset:kind = "column"
        string steel:preset:name = "Column heavy"
        int steel:preset:class = 1
        string steel:preset:material = "Steel"
        string steel:preset:profile = "H-300x300"
    }

    def Scope "Column_Hollow"
    {
        token steel:preset:kind = "column"
        string steel:preset:name = "Column hollow"
        int steel:preset:class = 1
        string steel:preset:material = "Steel"
        string steel:preset:profile = "SHS-150x150x6"
    }

    def Scope "Plate"
    {
        token steel:preset:kind = "plate"
        string steel:preset:name = "Plate"
        int steel:preset:class = 3
        string steel:preset:material = "Steel"
        double steel:preset:thicknessMm = 10
    }

    def Scope "Plate_Thick"
    {
        token steel:preset:kind = "plate"
        string steel:preset:name = "Plate thick"
        int steel:preset:class = 3
        string steel:preset:material = "Steel"
        double steel:preset:thicknessMm = 20
    }

    def Scope "Plate_Thin"
    {
        token steel:preset:kind = "plate"
        string steel:preset:name = "Plate thin"
        int steel:preset:class = 3
        string steel:preset:material = "Steel"
        double steel:preset:thicknessMm = 6
    }
}

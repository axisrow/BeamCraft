#usda 1.0
(
    doc = "BeamCraft Australia environment: cold-formed circular, rectangular and square hollow sections of AS/NZS 1163:2016, the common series of its Appendix D. The nominal dimensions, areas and masses are the published values, re-entered by hand as our own data; no text or table is copied. The outer corner radius is the one the standard fixes for the series (2.0t to 3.0 mm thickness, 2.5t above). Reference data for modelling; it is not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "australia-asnzs-1163-hollows"
        string "bim:library:title" = "Australia hollow sections (AS/NZS 1163: CHS, RHS, SHS)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Dimensional facts of AS/NZS 1163:2016 (CHS, RHS and SHS of Appendix D) re-entered by hand as our own data; cross-checked against the InfraBuild Know Your Steel catalogue 2021 and the Easysteel Steel Book 2025; no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


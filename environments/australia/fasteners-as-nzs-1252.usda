#usda 1.0
(
    doc = "BeamCraft Australian structural hex-bolt set: the dimensions of AS/NZS 1252 (high-strength steel fastener assemblies for structural engineering, 2016, bolts of property class 8.8 with their nuts and washers), re-entered by hand as our own data; the assembly holes follow the AS/NZS 5131 standard-hole series that AS 4100 clause 9.5.5 calls up. No text or table is copied from a standard document. BeamCraft contributors, MPL-2.0. Not for design use."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "beamcraft-asnzs-fasteners"
        string "bim:library:title" = "BeamCraft Australian structural hex bolt set (AS/NZS 1252)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Public standard AS/NZS 1252 (property class 8.8 assemblies), re-entered as our own data; the holes follow the AS/NZS 5131 standard-hole series; thread protrusion and the offered lengths are contributor defaults"
        string "bim:library:licence" = "MPL-2.0"
    }
)


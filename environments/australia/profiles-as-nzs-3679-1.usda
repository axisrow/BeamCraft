#usda 1.0
(
    doc = "BeamCraft Australia environment: hot-rolled universal beams (UB) and universal columns (UC) of AS/NZS 3679.1:2016. The nominal dimensions, areas and masses are the published values, re-entered by hand as our own data; no text or table is copied. A designation carries the mass per metre the series publishes (for example 530UB92.4). Reference data for modelling; it is not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "australia-asnzs-3679-profiles"
        string "bim:library:title" = "Australia hot-rolled sections (AS/NZS 3679.1: UB, UC)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Dimensional facts of AS/NZS 3679.1:2016 (UB and UC series) re-entered by hand as our own data; cross-checked between the InfraBuild catalogue, 9th edition 2019 (infrabuild.com) and the Easysteel Steel Book 2025 (easysteel.co.nz); no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


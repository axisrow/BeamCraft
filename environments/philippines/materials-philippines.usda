#usda 1.0
(
    doc = "BeamCraft Philippines structural steel grades: the grade designations the ESC Steel Philippines wide-flange page (escsteelstructures.ph) names for locally supplied sections — ASTM A36 and the complete strength-grade set of A572, the EN 10025-2 grade set the europe pack ships (2019 edition), SS400 of JIS G 3101, SM400A/B/C, SM490A/B/C and SM490YA/YB of JIS G 3106, and SN400A/B/C and SN490B/C of JIS G 3136, that standard's complete set. ESC prints no editions and no tables; every row declares the publicly documented edition of its standard. The KS D 3503 and KS D 3515 designations the page also names are the same strings the JIS rows carry and add no row. Re-entered by hand as our own data; the density is the 7850 kg/m3 every shipped profile pack computes its masses with (EN 1991-1-1). BeamCraft contributors, MPL-2.0. Not for design use."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "philippines-esc-materials"
        string "bim:library:title" = "Philippines structural steel grades (the ESC list: ASTM, EN 10025-2, JIS)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "ESC Steel Philippines grade list (escsteelstructures.ph, retrieved 2026-11-24): ASTM editions as the usa pack declares them, the EN 10025-2:2019 set of the europe pack, JIS G 3101:2015, G 3106:2020 and G 3136:2012; re-entered as our own data"
        string "bim:library:licence" = "MPL-2.0"
    }
)

def Scope "Library"
{
    def Scope "Materials"
    {
        def Scope "A36"
        {
            string steel:material:grade = "A36"
            string steel:material:standard = "ASTM A36/A36M-19"
            double steel:material:densityKgM3 = 7850
        }

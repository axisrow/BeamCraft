#usda 1.0
(
    doc = "BeamCraft Chinese hex-bolt set: the dimensions of GB/T 5782 (hexagon head bolts, product grades A and B, the 2025 edition in force since 2026-02-01, a modified adoption of ISO 4014:2022 - the M12-24 dimension rows are identical to the withdrawn 2016 edition), GB/T 6170 (hexagon nuts style 1, 2015 edition, ISO 4032), GB/T 97.1 (plain washers grade A, 2002 edition, ISO 7089), re-entered by hand as our own data; standard holes follow the medium assembly series of GB/T 5277. No text or table is copied from a standard document. BeamCraft contributors, MPL-2.0. Not for design use."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "beamcraft-gb-fasteners"
        string "bim:library:title" = "BeamCraft Chinese hex bolt set (GB/T 5782, GB/T 6170, GB/T 97.1)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Public standards GB/T 5782 (2025 edition, MOD ISO 4014:2022), GB/T 6170 (2015, ISO 4032), GB/T 97.1 (2002, ISO 7089) and GB/T 5277 (medium assembly), re-entered as our own data; thread protrusion is a contributor default"
        string "bim:library:licence" = "MPL-2.0"
    }
)


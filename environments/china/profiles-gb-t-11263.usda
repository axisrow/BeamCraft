#usda 1.0
(
    doc = "BeamCraft China environment: hot-rolled H-sections of GB/T 11263-2017 (re zha H xing gang he po fen T xing gang, hot rolled H and cut T section steel), table 1: the HW wide-flange, HM middle-flange and HN narrow-flange series. The nominal dimensions, areas and masses are the published values of the public standard, re-entered by hand as our own data; no text or table is copied. The parallel flanges ride the kernel's i_shape family: h is the section height, b the flange width, tw the web thickness (the standard's t1), tf the flange thickness (t2) and r the root fillet radius. Designations are Latinized with the series prefix followed by the actual height and width (the standard's authentic form HW/HM/HN + height x width; its * note marks less-common stock and is not part of the designation). The thin-wall HT series and the HP pile series of the same standard are not in this pack. Reference data for modelling; it is not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "china-gb-t-11263-profiles"
        string "bim:library:title" = "China hot-rolled sections (GB/T 11263-2017: HW/HM/HN H-sections)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Dimensional facts of GB/T 11263-2017 (table 1), re-entered by hand as our own data; read from the official standard text, cross-checked against 164580.com and the TungHo CNS/JIS list, identity formula verified per row; retrieved 2026-11-15; no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


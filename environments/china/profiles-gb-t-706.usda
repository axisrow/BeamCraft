#usda 1.0
(
    doc = "BeamCraft China environment: hot-rolled I-beams (gongzigang, gong Zi Gang) of GB/T 706-2016, table A.1. The nominal dimensions, areas and masses are the published values of the public standard, re-entered by hand as our own data; no text or table is copied. The inner flange faces rise at the slope 1:6 the standard prints in its section figure; t is the mid-leg flange thickness; r and r1 are the root and toe radii (the standard notes they are roll-pass reference values, not delivery conditions). Designations are Latinized with the series prefix I (the channel series of the same standard, caogang, joins this library with the prefix C; the numeric designations overlap between the series). Reference data for modelling; it is not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "china-gb-t-706-profiles"
        string "bim:library:title" = "China hot-rolled sections (GB/T 706-2016: tapered-flange I-beams)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Dimensional facts of GB/T 706-2016 (I-beam table A.1), re-entered by hand as our own data; read from the official standard text (openstd.samr.gov.cn registry, English edition) and cross-checked against 164580.com; no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


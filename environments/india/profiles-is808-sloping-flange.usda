#usda 1.0
(
    doc = "BeamCraft India environment: the legacy sloping-flange hot-rolled series of IS 808:2021 - the medium (MB) and wide (WB) beams of tables 1-2, the junior (JB) and light (LB) beams, the column (SC) and heavy beam (HB) sections and the MC/JC/LC channels - through the tapered_i and tapered_c families. The dimensions, areas and masses are the published values of the public standard, re-entered by hand as our own data; no text or table is copied. T is the mean flange thickness at the middle of the leg (the standard's annex A reading) and the slope column's angle over the flange plane carries as k = tan(angle - 90 degrees). Heavier rows of a shared depth take the depth-x-mass designation the standard requires when ordering them; seventeen printed rows whose toe radius exceeds their annex-A toe thickness are absent, named in the tests. Reference data; not a substitute for the standard itself. Provenance: ATTRIBUTION.md."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "india-is808-sloping-flange-profiles"
        string "bim:library:title" = "India hot-rolled sections (IS 808:2021: sloping flange beams, columns, heavy beams and channels)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "IS 808:2021 tables 1-2, 5, 6-7 (sloping flange series), re-entered by hand as our own data; cross-checked between the IS 808:2021 text and the IS 808:1989 scan (archive.org gov.in.is.808.2021, gov.in.is.808.1989); no table copied; retrieved 2026-11-16"
        string "bim:library:licence" = "MPL-2.0"
    }
)


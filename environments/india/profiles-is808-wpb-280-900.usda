#usda 1.0
(
    doc = "BeamCraft India environment: hot-rolled I beams with parallel flanges of the wide parallel flange beam (WPB) series of IS 808:2021 (table 4, the assortment of IS 12778:2004 amalgamated into the 2021 edition). The nominal dimensions, areas and masses are the published values of the public standard, re-entered by hand as our own data; no text or table is copied. Designations keep the published depth x width x mass form without spaces. Reference data for modelling; it is not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "india-is808-wpb-280-900-profiles"
        string "bim:library:title" = "India hot-rolled sections (IS 808:2021: wide parallel flange beams, depths 280 to 900)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Dimensional facts of IS 808:2021 (wide parallel flange beam (WPB) series, table 4) re-entered by hand as our own data; no table copied; cross-checked against the printed IS 808:2021 text and the independent edition IS 12778:2004; retrieved 2026-11-15"
        string "bim:library:licence" = "MPL-2.0"
    }
)


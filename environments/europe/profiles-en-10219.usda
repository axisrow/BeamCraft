#usda 1.0
(
    doc = "BeamCraft Europe environment: cold-formed hollow sections (SHS, RHS and CHS) of the common EN 10219 sizes. The nominal dimensions, areas and masses are the published values of the public standard EN 10219-2:2006, re-entered by hand as our own data; no text or table is copied. Every row follows the corner geometry the standard computes its sectional properties with: the outer corner radius is 2t up to 6 mm wall, 2.5t from 6 to 10 mm and 3t above 10 mm, and the inner radius is the outer radius minus the wall. Reference data for modelling; it is not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "europe-en-10219-profiles"
        string "bim:library:title" = "Europe cold-formed hollow sections (EN 10219: SHS, RHS, CHS)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Dimensional facts of EN 10219-2:2006 (cold-formed SHS, RHS and CHS sizes) re-entered by hand as our own data; cross-checked between the SCI P363 tables (steelconstruction.info) and the Hiap Teck BS EN 10219 datasheet (hiapteck.com); no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


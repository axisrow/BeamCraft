#usda 1.0
(
    doc = "BeamCraft Europe structural steel grades: the grade designations of EN 10025-2 (non-alloy structural steels), EN 10025-3 (normalized/normalized rolled weldable fine grain steels) and EN 10025-4 (thermomechanical rolled weldable fine grain steels), re-entered by hand as our own data; the density is the 7850 kg/m3 every shipped profile pack computes its masses with (EN 1991-1-1). No text or table is copied from a standard document. BeamCraft contributors, MPL-2.0. Not for design use."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "europe-en-10025-materials"
        string "bim:library:title" = "EN 10025 structural steel grades (parts 2, 3 and 4)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Public standard EN 10025-2/-3/-4 grade designations, re-entered as our own data; density is the 7850 kg/m3 of EN 1991-1-1 and of the shipped profile packs"
        string "bim:library:licence" = "MPL-2.0"
    }
)


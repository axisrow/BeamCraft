#usda 1.0
(
    doc = "BeamCraft Europe environment: hot-rolled I and H sections of the IPE, HEA and HEB series. The nominal dimensions, areas and masses are the published values of the public standard EN 10365:2022, re-entered by hand as our own data; no text or table is copied. Reference data for modelling; it is not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "europe-en-10365-profiles"
        string "bim:library:title" = "Europe hot-rolled sections (EN 10365: IPE, HEA, HEB)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Dimensional facts of EN 10365:2022 (IPE, HEA, HEB series, sizes 100 to 600) re-entered by hand as our own data; cross-checked against the DSTV digitale Stahlbautabellen (bauforumstahl.de), wauben.nl and masteel.co.uk; no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


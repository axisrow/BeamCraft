#usda 1.0
(
    doc = "BeamCraft Europe environment: hot-rolled I and H sections of the IPE, HEA and HEB series, the parallel-flange UPE channel series and the taper-flange UPN channel series. The nominal dimensions, areas and masses are the published values of the public standard EN 10365:2022, re-entered by hand as our own data; no text or table is copied. The UPN rows carry the taper-flange channel geometry: the inner flange faces rise at the slope the standard prints (8 percent up to UPN 300, 5 percent for UPN 320 to 400), t is the mid-leg flange thickness, r and r1 are the root and toe radii. The declared UPN areas follow the convention the standard publishes (steel:profile:areaConvention): the UPN 50 to 300 areas are the nominal sharp-cornered constant-flange value the standard prints (no fillet allowance), and the UPN 320 to 400 areas are the exact area of the filleted tapered section; the D3 declared-area check compares like-for-like. Reference data for modelling; it is not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "europe-en-10365-profiles"
        string "bim:library:title" = "Europe hot-rolled sections (EN 10365: IPE, HEA, HEB, UPE, UPN)"
        string "bim:library:version" = "3"
        string "bim:library:source" = "EN 10365:2022 nominal facts (IPE/HEA/HEB 100-600, UPE 80-400, UPN 50-400) re-entered by hand; cross-checked against bauforumstahl.de, montanstahl.com, millstockgroup.com, structurecalcs.com, mesteel.com and masteel.co.uk; no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


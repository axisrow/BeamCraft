#usda 1.0
(
    doc = "BeamCraft Europe environment: hot-rolled I and H sections of the IPE, HEA, HEB, HL, HLZ, HD and HP series, the HEA and HEB rows running to 1000, plus the parallel-flange UPE and taper-flange UPN channel series. The nominal dimensions, areas and masses are the published values of the public standard EN 10365:2017, re-entered by hand as our own data; no text or table is copied. The EN tables print no root radius for the HL series; those rows carry the radius reproducing the published area. The UPN rows carry the taper-flange geometry: inner flange faces rise at the printed slope (8 percent to UPN 300, 5 percent for 320 to 400), t is the mid-leg thickness, r and r1 the root and toe radii. The declared UPN areas follow steel:profile:areaConvention: UPN 50 to 300 are the nominal sharp-cornered constant-flange value (no fillet allowance), UPN 320 to 400 the exact filleted tapered area; the D3 check compares like-for-like. Reference data for modelling; it is not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "europe-en-10365-profiles"
        string "bim:library:title" = "Europe hot-rolled sections (EN 10365: IPE, HEA, HEB, HL, HLZ, HD, HP, UPE, UPN)"
        string "bim:library:version" = "4"
        string "bim:library:source" = "EN 10365:2017 nominal facts (IPE/HEA/HEB 100-1000, HL, HLZ, HD, HP, UPE 80-400, UPN 50-400) re-entered by hand; cross-checked against bauforumstahl.de, structurecalcs.com, emsteel.com and the ArcelorMittal HLZ tables; no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


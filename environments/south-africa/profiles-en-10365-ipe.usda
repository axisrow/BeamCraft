#usda 1.0
(
    doc = "BeamCraft South Africa environment: the IPE series of hot-rolled parallel-flange I sections, IPE 100 to IPE 600. The nominal dimensions, areas and masses are the published values of the public standard EN 10365:2017, the standard that carries the IPE series DIN 1025-5 specified before EN 10365 superseded it, re-entered by hand as our own data; no text or table is copied. The rows are the IPE rows of the `europe` pack. The BS UB/UC universal beam and column series of South African practice and the HEA, HEB, UPE and UPN series of the same standard are not in this library. Reference data for modelling; it is not a substitute for the standard itself."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "south-africa-en-10365-ipe-profiles"
        string "bim:library:title" = "South Africa hot-rolled sections (EN 10365: IPE)"
        string "bim:library:version" = "1"
        string "bim:library:source" = "EN 10365:2017 nominal facts (IPE 100-600), the IPE rows of the europe pack carried unchanged; heights, widths, thicknesses and masses cross-checked against the EMSTEEL Heavy Sections catalogue (IPE 270-600); no table copied"
        string "bim:library:licence" = "MPL-2.0"
    }
)


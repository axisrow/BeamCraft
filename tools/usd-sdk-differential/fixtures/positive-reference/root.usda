#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.001
    subLayers = [@authored.usda@, @derived.usda@]
    upAxis = "Z"
)

def Xform "World"
{
    double probe = 1

    def Xform "References"
    {
        def Xform "REF_aaaaaaaabbbbccccddddeeeeeeeeeeee" (
            kind = "component"
            displayName = "Synthetic Reference"
        )
        {
            custom string bim:id = "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
            custom string bim:elementKind = "reference"
            custom string bim:reference:sourceDigest = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
            double3 xformOp:translate = (100, 50, 200)
            double xformOp:rotateX:bimUpAxis = -90
            double3 xformOp:scale:bimUnits = (1000, 1000, 1000)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX:bimUpAxis", "xformOp:scale:bimUnits"]

            def Xform "Correction"
            {
                def "Source" (
                    prepend references = @external/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef.usda@</Site>
                )
                {
                }
            }
        }
    }
}
